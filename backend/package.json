{
  "name": "integrated-lookup-toolkit-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Integrated Lookup Toolkit - Unified Cyber Security Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=routes --watch-path=services --watch-path=config --watch-path=middleware --watch-path=server.js server.js",
    "test:accuracy": "node scripts/verify-accuracy.js",
    "db:push": "node scripts/autopush.js",
    "db:seed": "node scripts/autopush.js --force-seed",
    "db:check": "node scripts/check-connection.js",
    "db:setup": "node scripts/autopush.js && node scripts/check-connection.js",
    "reset:admin": "node scripts/reset-admin.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "pg": "^8.23.0",
    "validator": "^13.12.0",
    "whois-json": "^2.0.4"
  }
}
