# ==========================================
# Integrated Lookup Toolkit - Backend Environment
# ==========================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Connection String (Pooler / Direct)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Project API Details
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# VirusTotal API Key (Cyber Threat Intelligence & Malware Scanner)
# Obtain a free API key at https://www.virustotal.com/
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
